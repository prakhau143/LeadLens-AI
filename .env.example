# --- Self-hosted Qwen (primary path; vLLM on AWS, or Ollama locally) ---
# When QWEN_BASE_URL is set the app talks to YOUR OpenAI-compatible server.
# Ollama (local dev):  QWEN_BASE_URL=http://localhost:11434/v1  QWEN_MODEL=qwen3-vl:4b
# vLLM on AWS:         QWEN_BASE_URL=http://vllm:8000/v1        QWEN_MODEL=Qwen/Qwen3-VL-4B-Instruct
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_API_KEY=
# Used only by docker/docker-compose.aws.yml for HTTPS
SITE_ADDRESS=

# --- Qwen3-VL on a Hugging Face Space (ZeroGPU); used when QWEN_BASE_URL is empty ---
# Server-side only. Never prefix these with NEXT_PUBLIC_.
# HF_SPACE_ID=your-username/leadlens-qwen3-vl
# HF_TOKEN=            # required for a private Space; also sets whose ZeroGPU quota is used
# HF_SPACE_MODEL=Qwen/Qwen3-VL-4B-Instruct   # label only; the Space decides the real model
HF_SPACE_ID=
HF_TOKEN=
HF_SPACE_MODEL=

# --- Fallback: Vercel AI Gateway (hosted; NOT a self-deployed model) ---
# Used only when QWEN_BASE_URL is empty.
# Not required when this project is linked to Vercel locally (`vercel link` +
# `vercel env pull`) — auth then flows automatically via VERCEL_OIDC_TOKEN.
# Required for CI, external servers, or non-Vercel deployments.
AI_GATEWAY_API_KEY=

# Qwen vision-language model id, as returned by https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=alibaba/qwen3.5-flash

# Upload limits (enforced server-side, not just in the UI)
MAX_UPLOAD_IMAGES=50
MAX_IMAGE_SIZE_MB=8
